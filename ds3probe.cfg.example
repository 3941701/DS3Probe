# ds3probe.cfg - справочник ВСЕХ ключей (v4.10). Готовые файлы: ds3probe_play.cfg.example (для игры, исправление мыши)
# и ds3probe_camdump.cfg.example (отладка камеры: трассировщики, дампы, ловец писателей).
# Для 1.0.0.1 (MD5 1802f17a2cc1c2797323632862c6fb1f) адреса уже зашиты в DLL по MD5 файла, но сами исправления
# (FollowFix, StickClamp, ZeroGYaw, AimLinear) включаются только из cfg и требуют трассировщиков с ролями (см. ниже).
#
# Имя файла: ds3probe_<md5 exe>.cfg (для конкретной сборки) или ds3probe.cfg. Первый найденный читается.
# Строгий разбор: любая ошибка (опечатка в адресе, неизвестный ключ, строка без '=', число вне диапазона) =
# exe-хуки НЕ ставятся вообще, причина пишется в лог ("cfg: parsed, N error(s)"). Всё после '#' - комментарий.
# Адреса - в системе координат Ghidra той же сборки exe (база 0x400000), hex, до 8 цифр.
# Хук ставится, только если .bytes заданы (>= 8 байт, >= 5 не-масок) и совпали с памятью. '??' = любой байт.
#
# --- защита от чужой сборки (рекомендуется для любого нового cfg) ---
# MD5 = 1802f17a2cc1c2797323632862c6fb1f
# Build = 511E9327                      # PE TimeDateStamp из лога (строка "exe MD5=... PE TimeDateStamp=...")
#
# --- исправления (v4.5+) ---
# FollowFix = 1         # обход сглаживания камеры с запуска (F4 переключает на лету). Нужен трассировщик LookUpdate с .role = ctrl.
#                       # Каждый кадр на входе LookUpdate пишет ctrl+0x13C/0x140 так, что вес смешивания внешнего кадра камеры = 1.
# FollowTauMs = 0       # 0..2000. 0 = камера точно в цели; >0 - своя постоянная времени (вес 1-exp(-dt/tau)); оригинал ~127 мс
# StickClamp = 1000000000   # 0..1e9. Клэмп сглаживателя стика FUN_0040D820 this[3] (игра: 2.0). 0 = не трогать, 1e9 = без клэмпа
#                           # (линейный отклик на быстрых рывках). F11 перекрывает ступенью; на уровне 0 берётся это значение.
# ZeroGYaw = 2.15       # 0.1..10. Множитель выхода сглаживателя только при вызове из кода свободного полёта (0054F806).
# ZeroGPitch = 1.0      # 2.15 по yaw выравнивает невесомость с землёй (1.8326 -> 3.94 рад/с на единицу стика).
# AimLinear = 1         # прицел без разгона усиления (игра: yaw до x2, pitch до x4 при быстром ведении). Нужен трассировщик
#                       # ApplyRotDelta (00721BD0) с .role = aimlin и включённый FollowFix/F4.
# LookPitch = 1.0       # v4.10, 0.1..10. Множитель вертикали обычной камеры (земля и магнитная поверхность, вызов сглаживателя 0073F407).
#                       # При ползунке 50 игра даёт yaw 3.94, pitch 1.833 рад/с на единицу (на поверхности 1.309): вертикаль в 2.15 раза
#                       # медленнее. 2.15 = вертикаль как горизонталь на земле. Прицел и невесомость не трогает.
# LookPitch, ZeroGYaw/ZeroGPitch и AimLinear (v4.10) действуют только на мышь: пара геймпада (байт сглаживателя +0x30 = 0) идёт как в игре.
#
# --- служебные параметры ---
# ExeHooks = 1          # 0 = только user32/DirectInput, без хуков в exe (исправления тогда не работают)
# StickHooks = 1        # 0 = не ставить хуки конвейера "стик" (FUN_0040E680 / FUN_0040D820); F11, StickClamp, ZeroG тогда недоступны
# Anchor = 1            # сверка с экспортом ?Init@Mouse@Windows@EARS@@YAXXZ
# Beeps = 1             # звуки хоткеев (0 = без звука)
# DiScaleA = 0.5        # множители режимов F9: DI-xA / DI-xB / DI-xC (только для опытов)
# DiScaleB = 0.25
# DiScaleC = 2.0
# OffSens = 17C         # смещение множителя мыши в объекте InputMapper (this = ecx), только для лога
# OffMouseState = 18C   # смещение указателя на MouseState, только для лога
# RawScale = 1.0        # не используется с v4 (режим RAW убран), ключ принимается для совместимости
# RawInputRef = 0       # v4.10: 1 = зарегистрировать мышь Raw Input (скрытое окно, RIDEV_INPUTSINK) как эталон для опытов v3/v4.
#                       # По умолчанию выключено: эталон с v4 не нужен, а при поздней загрузке DLL регистрация может отнять мышь у DirectInput.
#
# --- трассировщики: mid-хук на любой инструкции (обычно вход функции), до 8 штук (Trace1 ... Trace8) ---
# Обязательные: адрес и байты (скопируй из Ghidra: выдели начало функции -> Copy Special -> Byte String; первые 8+ байт).
# Необязательные:
#   .name      подпись в логе (до 40 символов)
#   .args      сколько dword стека снимать, 0..8 (умолч. 6)
#   .this      сколько dword по base снимать, 0..16 (умолч. 8)
#   .base      регистр, по которому читаются .this, .fields и .dump: ecx|edx|eax|ebx|esi|edi|ebp|esp (умолч. ecx)
#   .fields    до 16 смещений в hex от base, читается dword по каждому: Trace2.fields = 70 150 158 C8 CC
#   .dump      <смещение hex, можно с минусом> <длина hex, кратна 4, <= 400>: дамп памяти от base в _dump.csv (v4.2)
#   .dumpfrom  0..8: брать указатель для дампа из base-регистра другого трассировщика (0 = свой)
#   .role      ctrl     - base = объект-контроллер LookUpdate (нужно для FollowFix/F4 и Watch ctrl)
#              camblock - base = блок камеры cam+0x20 (для Watch camblock)
#              aimlin   - этот хук на ApplyRotDelta подменяет аргументы из кода прицела (AimLinear)
#              apply    - устарело с v4.5, принимается и ничего не делает
# Хук можно ставить не только на вход функции, но и на любую инструкцию (например, сразу после CALL, чтобы увидеть
# eax = возвращаемое значение): тогда [esp] - просто dword на вершине стека, а не адрес возврата.
# Результат: строки "Trace1 <имя> #N: ecx=... ret=..." в логе (первые вызовы) и ds3probe_cap_NNN_trace.csv во время захвата.
# Пример (рабочий для 1.0.0.1, из ds3probe_play.cfg.example):
# Trace2 = 0073F310
# Trace2.bytes = 53 8B DC 83 EC 08 83 E4 F0 83 C4 04
# Trace2.name = LookUpdate
# Trace2.args = 0
# Trace2.this = 0
# Trace2.role = ctrl
#
# --- ловец писателей (v4.4, F3 вкл/выкл): аппаратные точки останова, до 4 штук ---
# WatchN = <abs|ctrl|camblock> <hex смещение, кратное 4 (для abs - полный адрес)> <w|rw>
# Watch1 = ctrl 44 w
#
# --- переопределение адресов профиля (редко; если задан новый адрес, байты профиля сбрасываются - задай и .bytes) ---
# MouseGetState = 0040A820
# MouseGetState.bytes = 55 8B EC DB 05 D0 1D 1D 01 8B 45 08
# PollMouseCursor = 0040CE30
# PollMouseCursor.bytes = 55 8B EC 83 EC 28 56 8B 35 F4 1D 1D
# WndMsg = 0040D270
# WndMsg.bytes = 55 8B EC 8B 45 08 83 EC 28 53 8B 5D
# InputMapper = 00ACB780
# InputMapper.bytes = 55 8B EC 83 EC 18 53 56 57 8B 7D 10
# StickVirt = 0040E680
# StickVirt.bytes = ...
# StickSmooth = 0040D820
# StickSmooth.bytes = ...
# AccDX = 011D1DD0
# AccDY = 011D1DD4
# FlagCaptured = 011D1DCE
# FlagRecenter = 011D1DEE
# VirtW = 0133B0A8                      # рабочие имена g_virtW/H, только для строки условий в логе
# VirtH = 0133B0AC
# MgrPtr = 011D1914                     # указатель на менеджер устройств ввода (самопроверка смещений)
