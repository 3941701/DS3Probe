# ds3probe.cfg - НЕОБЯЗАТЕЛЬНЫЙ файл рядом с deadspace3.exe. Для 1.0.0.1 (MD5 1802f17a2cc1c2797323632862c6fb1f)
# адреса уже зашиты в DLL по MD5 файла: ничего создавать не нужно. Файл нужен для трассировщиков и тонкой настройки.
#
# Имя файла: ds3probe_<md5 exe>.cfg (для конкретной сборки) или ds3probe.cfg. Первый найденный читается.
# Строгий разбор: любая ошибка (опечатка в адресе, неизвестный ключ, строка без '=') = exe-хуки НЕ ставятся,
# причина пишется в лог. Адреса - в системе координат Ghidra той же сборки exe, hex, до 8 цифр.
# Хук ставится, только если .bytes заданы (>= 8 байт, >= 5 не-масок) и совпали с памятью. '??' = любой байт.
#
# --- защита от чужой сборки (рекомендуется для любого нового cfg) ---
# MD5 = 1802f17a2cc1c2797323632862c6fb1f
# Build = 511E9327                      # PE TimeDateStamp из лога (строка "exe MD5=... PE TimeDateStamp=...")
#
# --- параметры ---
# ExeHooks = 1          # 0 = только user32/DirectInput, без хуков в exe
# StickHooks = 1        # 0 = не ставить хуки конвейера "стик" (FUN_0040E680 / FUN_0040D820); F11 тогда недоступна
# Anchor = 1            # сверка с экспортом ?Init@Mouse@Windows@EARS@@YAXXZ
# Beeps = 1             # звуки на F7/F8/F9/F11
# DiScaleA = 0.5        # множители режимов F9: DI-xA / DI-xB / DI-xC
# DiScaleB = 0.25
# DiScaleC = 2.0
# OffSens = 17C         # смещение множителя мыши в объекте InputMapper (this = ecx)
# OffMouseState = 18C   # смещение указателя на MouseState
#
# --- трассировщики: хук на ВХОДЕ любой функции, до 8 штук (Trace1 ... Trace8) ---
# Обязательные: адрес и байты (скопируй из Ghidra: выдели начало функции -> Copy Special -> Byte String; первые 8+ байт).
# Необязательные: .name (подпись в логе), .args (сколько dword стека снимать, 0..8, умолч. 6),
#                 .this (сколько dword по base снимать, 0..16, умолч. 8),
#                 .base (v4.1: регистр, по которому читаются .this и .fields: ecx|edx|eax|ebx|esi|edi|ebp|esp, умолч. ecx),
#                 .fields (v4.1: до 16 смещений в hex от base, читается dword по каждому: Trace2.fields = 70 150 158 C8 CC).
# В CSV (v4.1) добавлены колонки eax, base (значение регистра) и f0..f15. Хук можно ставить не только на вход функции,
# но и на любую инструкцию (например, сразу после CALL, чтобы увидеть eax = возвращаемое значение): тогда [esp] - просто
# dword на вершине стека, а не адрес возврата.
# Готовый блок для камеры генерирует ghidra/DS3_CamChain.py (раздел 0 отчёта): скопируй его сюда целиком.
# Результат: строки "Trace1 <имя> #N: ecx=... ret=..." в логе (первые вызовы) и ds3probe_cap_NNN_trace.csv во время захвата.
# Пример (ЗАМЕНИ байты на настоящие из Ghidra своей сборки, здесь они условные):
# Trace1 = 00ABC510
# Trace1.bytes = 55 8B EC 83 E4 F8 83 EC 20
# Trace1.name = AxisPairFetch
# Trace1.args = 8
# Trace1.this = 0
#
# --- переопределение адресов профиля (редко; если задан новый адрес, байты профиля сбрасываются - задай и .bytes) ---
# MouseGetState = 0040A820
# MouseGetState.bytes = 55 8B EC DB 05 D0 1D 1D 01 8B 45 08
# PollMouseCursor = 0040CE30
# PollMouseCursor.bytes = 55 8B EC 83 EC 28 56 8B 35 F4 1D 1D
# WndMsg = 0040D270
# WndMsg.bytes = 55 8B EC 8B 45 08 83 EC 28 53 8B 5D
# InputMapper = 00ACB780
# InputMapper.bytes = 55 8B EC 83 EC 18 53 56 57 8B 7D 10
# StickVirt = 0040E680
# StickSmooth = 0040D820
# AccDX = 011D1DD0
# AccDY = 011D1DD4
# FlagCaptured = 011D1DCE
# FlagRecenter = 011D1DEE
# VirtW = 0133B0A8                      # рабочие имена g_virtW/H, только для строки условий в логе
# VirtH = 0133B0AC
# MgrPtr = 011D1914                     # указатель на менеджер устройств ввода (самопроверка смещений)
