# DS3Probe v4.9 - cfg для опыта "где рикошёт": дампы памяти объекта камеры + знакомые трассировщики.
# Положи рядом с deadspace3.exe под именем ds3probe.cfg (старый cfg сохрани под другим именем).
# Байты взяты из Приложения A отчёта (база Ghidra 1.0.0.1).
MD5 = 1802f17a2cc1c2797323632862c6fb1f
Build = 511E9327

# применение дельты поворота: a0 = dPitch, a1 = dYaw (вызывается и из LookUpdate, и из прицельной ветки)
Trace1 = 00721BD0
Trace1.bytes = 53 8B DC 83 EC 08 83 E4 F0 83 C4 04
Trace1.name = ApplyRotDelta
Trace1.args = 6
Trace1.this = 3

# основное обновление взгляда (обычная камера). Дамп 0x300 байт самого объекта-контроллера.
Trace2 = 0073F310
Trace2.bytes = 53 8B DC 83 EC 08 83 E4 F0 83 C4 04
Trace2.name = LookUpdate
Trace2.args = 2
Trace2.this = 0
Trace2.fields = 70 150 158 C8 CC D0 D4 D8 74 7C 90 134 138 164 1D0 618
Trace2.dump = 0 300
Trace2.role = ctrl

# после CALL OwnerCheck в LookUpdate: a4 = тангаж, a5 = рыскание локальной копии (как в прошлых захватах)
Trace3 = 0073FA33
Trace3.bytes = 84 C0 74 31 39 75 D0 75 2C 8B 7D B4
Trace3.name = OwnerCheckRet
Trace3.args = 6
Trace3.this = 0

# SetTransform: вызывается раз в кадр обычной камеры уже после фиксации. Дамп объекта камеры
# (указатель = edi из Trace8 = cam+0x20, поэтому смещение -20 даёт начало объекта камеры).
Trace4 = 0073CEB0
Trace4.bytes = 55 8B EC 8B 45 08 D9 EE 0F 28 00
Trace4.name = SetTransform
Trace4.args = 4
Trace4.this = 4
Trace4.role = apply          # v4.5: роль apply больше не нужна (F4 пишет на входе LookUpdate, role=ctrl), строку можно оставить
Trace4.dumpfrom = 8
Trace4.dump = -20 300

# следящая камера: вызывается и в прицеле. Дамп того же объекта камеры.
Trace5 = 0074BAA0
Trace5.bytes = 53 8B DC 83 EC 08 83 E4 F0 83 C4 04
Trace5.name = CamFollow
Trace5.args = 4
Trace5.this = 0
Trace5.fields = 70 170 174 178 1A0 1A4 1A8 1B4 1B8 1BC
Trace5.dumpfrom = 8
Trace5.dump = -20 300

# фиксация поворота (запись L -> cam+0x20): edi = cam+0x20. Дамп ДО записи; задаёт указатель камеры для Trace4/5.
Trace8 = 0073FA3F
Trace8.bytes = B9 28 00 00 00 8D B5 D0 FE FF FF
Trace8.name = CommitExec
Trace8.args = 2
Trace8.base = edi
Trace8.this = 3
Trace8.dump = -20 300
Trace8.role = camblock

# ---- v4.4: ловец писателей (F3 вкл/выкл). Аппаратные точки останова на слова объектов; результат - в ds3probe.log
# строки "watch-new/watch-summary": адрес инструкции (exe+..., ghidra ...) и стек вызовов.
# Формат:  WatchN = <ctrl|camblock|abs> <hex смещение, кратное 4> <w|rw>     (N = 1..4; для abs - полный адрес)
# ctrl = объект LookUpdate (role=ctrl), camblock = cam+0x20 (role=camblock).
Watch1 = ctrl 44 w
Watch2 = ctrl 20 w
Watch3 = ctrl 40 w
Watch4 = camblock 10 rw

# ---- v4.5: датчик "что уходит в SetTransform". Хук посреди FUN_0074D6F0 (0074DC6E: PUSH EDX; LEA ECX,[EBP-0F0]), EDX = указатель на
# результат FUN_0073EF10 (3 строки по 16 байт = матрица, которую получает SetTransform). Без обхода это отстающая ориентация
# (вес 7.5*dt), с обходом F4 - равна цели того же кадра. tools/analyze_follow.py печатает [V6] по этому трассировщику.
Trace6 = 0074DC6E
Trace6.bytes = 52 8D 8D 10 FF FF FF E8 ?? ?? ?? ??   # нужно >= 8 фиксированных байт, иначе хук пропускается (в 4.5/4.6 тут было 7 и датчик не ставился)
Trace6.name = BlendOut
Trace6.args = 0
Trace6.this = 0
Trace6.base = edx
Trace6.dump = 0 30

# ---- v4.5: обход сглаживания камеры (F4). Нужен только трассировщик Trace2 с role = ctrl (LookUpdate).
# FollowFix = 1       обход включён с запуска (F4 переключает на лету); по умолчанию выключен
# FollowTauMs = 0     0 = камера точно в цели (вес смешивания 1). Любое число > 0 - постоянная времени в мс вместо
#                     оригинальных ~127 мс (вес за кадр = 1-exp(-dt/tau)), например 30 - лёгкое сглаживание.
#FollowFix = 0
#FollowTauMs = 0

# ---- v4.6: постоянные настройки для игры (чтобы не жать F4/F11 при каждом запуске)
# StickClamp = 1000000000   клэмп сглаживателя стика FUN_0040D820 this[3] (игра: 2.0). 1e9 = без клэмпа, линейный отклик;
#                           F11 по-прежнему перекрывает ступенью, на уровне 0 берётся это значение
#StickClamp = 1000000000

# ---- v4.7: невесомость. ZeroGYaw / ZeroGPitch - множители выхода сглаживателя стика при вызове из кода свободного полёта (0054F806).
# В захвате 20261009_204726 усиление там 1.8326 рад/с на единицу стика по обеим осям; на земле yaw 3.94 (в 2.15 раза больше), pitch 1.833.
# В sticks.csv x_out/y_out пишутся ПОСЛЕ умножения (в шапке # zerog_scale).
#ZeroGYaw = 2.15
#ZeroGPitch = 1.0

# ---- v4.8: AimLinear - поворот в прицеле без "разгона" усиления (см. README). Нужна строка у Trace1 (ApplyRotDelta): Trace1.role = aimlin
#      (в записях Trace1 по-прежнему пишет ИСХОДНЫЕ значения a0/a1 игры, то есть по CSV видно, сколько "разгона" убрано). Действует при включённом F4.
#Trace1.role = aimlin
#AimLinear = 1
