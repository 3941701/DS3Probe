# DS3Probe v4.10 - минимальный cfg "для игры" (без дампов и лишних трассировщиков). Положи рядом с deadspace3.exe как ds3probe.cfg.
# Включает: обход сглаживания камеры (без инерции, вес смешивания 1), сглаживатель стика без клэмпа (линейный отклик),
# выравнивание горизонтали в невесомости (ZeroGYaw) и прицел без разгона усиления (AimLinear).
# F4 переключает обход на лету, F11 - ступени клэмпа. Для записей и анализа бери ds3probe_camdump.cfg.example.
# Проверен в игре в этом виде (v4.9, запись 20261009_225325: F4 применён в 4060 кадрах из 4067, AimLinear и ZeroGYaw работают).
MD5 = 1802f17a2cc1c2797323632862c6fb1f
Build = 511E9327

# ApplyRotDelta (v4.8): нужен для AimLinear. Хук ничего не делает, кроме подмены двух аргументов в вызовах из кода прицела (00552176, 00552222).
# Trace1.args = 2 вместо 0 пишет при записи (F8) углы поворота в trace.csv, по ним tools/analyze_gain.py считает усиление по осям.
Trace1 = 00721BD0
Trace1.bytes = 53 8B DC 83 EC 08 83 E4 F0 83 C4 04 55 8B 6B 04
Trace1.name = ApplyRotDelta
Trace1.args = 0
Trace1.this = 0
Trace1.role = aimlin

# LookUpdate: нужен только указатель на объект-контроллер (role = ctrl), на его входе F4 переписывает коэффициенты ctrl+0x13C/0x140
Trace2 = 0073F310
Trace2.bytes = 53 8B DC 83 EC 08 83 E4 F0 83 C4 04
Trace2.name = LookUpdate
Trace2.args = 0
Trace2.this = 0
Trace2.role = ctrl

FollowFix = 1
# FollowTauMs = 0         # 0 = камера точно в цели; >0 - мягкое сглаживание (оригинал около 127 мс), например 30
StickClamp = 1000000000

# v4.7: невесомость (свободный полёт). Там усиление 1.8326 рад/с на единицу стика по обеим осям, на земле yaw 3.94 (в 2.15 раза больше).
# ZeroGYaw = 2.15 выравнивает горизонталь с землёй; ZeroGPitch = 1 оставляет вертикаль как в игре (на земле pitch 1.833, на магнитной поверхности 1.309).
# Множитель действует только на вызов сглаживателя из кода свободного полёта (0054F806), на землю и прицел не влияет.
ZeroGYaw = 2.15
# ZeroGPitch = 1.0

# v4.8: прицел. Игра "разгоняет" усиление поворота в прицеле: при быстром ведении (выход сглаживателя больше 1) множитель растёт до 2x по yaw и
# до 4x по pitch (потолок найден в v4.9) и потом спадает, из-за чего чувствительность "плавает". AimLinear = 1 делает поворот строго линейным (100 градусов/с yaw
# и 80 градусов/с pitch на единицу стика, как на медленных движениях). Работает, пока включён обход (FollowFix = 1 или F4): F4 = игра как есть.
AimLinear = 1

# v4.10: вертикаль обычной камеры (земля и магнитная поверхность). При ползунке 50 игра поворачивает по горизонтали на 225.7 градуса/с
# на единицу стика, по вертикали на 105 (на магнитной поверхности на 75): вертикаль в 2.15 раза медленнее, в прицеле разница всего 1.25.
# LookPitch умножает только вертикаль мыши для этой камеры. 1 = как в игре, 2.15 = как горизонталь на земле. Подбирать на ощупь, например 1.5..2.15.
# LookPitch = 2.15
